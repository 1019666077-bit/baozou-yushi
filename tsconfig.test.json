{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"],
    "noEmit": true
  },
  "include": [
    "assets/scripts/domain/**/*.ts",
    "assets/scripts/content/IslandFishPool.ts",
    "assets/scripts/data/types.ts",
    "assets/scripts/platform/PlatformAdapter.ts",
    "assets/scripts/platform/WebLocalAdapter.ts",
    "assets/scripts/platform/CrazyGamesAdapter.ts",
    "assets/scripts/platform/AndroidAdapter.ts",
    "assets/scripts/platform/WechatAdapter.ts",
    "assets/scripts/platform/PlatformFactory.ts",
    "assets/scripts/platform/PlatformRuntime.ts",
    "assets/scripts/save/SaveService.ts",
    "cloudfunctions/shared/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.mts"
  ]
}
