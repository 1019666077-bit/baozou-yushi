{
  "name": "baozou-yushi",
  "uuid": "b95f2f44-1d3a-4fc5-91e6-507741cc3f67",
  "version": "0.1.0",
  "private": true,
  "type": "2d",
  "description": "原创动作钓鱼微信小游戏 MVP",
  "creator": {
    "version": "3.8.8"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:cocos": "tsc -p tsconfig.cocos-check.json --noEmit",
    "sync:config": "node tools/sync-bundled-config.mjs",
    "preflight": "node tools/sync-bundled-config.mjs && node tools/preflight.mjs",
    "preflight:web": "node tools/platform-preflight.mjs web",
    "preflight:crazygames": "node tools/platform-preflight.mjs crazygames",
    "preflight:android": "node tools/platform-preflight.mjs android",
    "preflight:platforms": "npm run preflight && npm run preflight:web && npm run preflight:crazygames && npm run preflight:android",
    "simulate": "node tools/simulate-economy.mjs",
    "playtest:report": "node tools/analyze-playtest.mjs",
    "metrics:crazygames": "node tools/analyze-crazygames.mjs",
    "testers:google": "node tools/analyze-google-testers.mjs",
    "release:readiness": "node tools/launch-readiness.mjs",
    "postbuild:wechat": "node tools/postbuild-wechat.mjs",
    "preview:extract": "node tools/first-run-preview/extract-copy.mjs",
    "preview:tide-station": "node tools/tide-station-preview/serve.mjs",
    "art:vector": "node tools/generate-vector-art.mjs",
    "try:web-desktop": "node tools/try-web-desktop-build.mjs",
    "serve:web-desktop": "npx --yes serve build/web-desktop -l 8765",
    "shots:list": "node tools/stage3d-shot-checklist.mjs",
    "validate": "npm run art:vector && npm run typecheck && npm run typecheck:cocos && npm test && npm run preflight && npm run preview:extract && npm run shots:list"
  },
  "devDependencies": {
    "@cocos/creator-types": "^3.8.8",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
